# Copy this file to .env for local development:  cp .env.example .env
# .env is gitignored — the real key must never be committed.
# On Render, set these same names in Dashboard -> your service -> Environment.

# Required. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-flash-latest

# Optional. Comma-separated list of sites allowed to call this backend (CORS).
# Defaults to the GitHub Pages site plus localhost:8000 / localhost:5500.
# ALLOWED_ORIGINS=https://cathhh204.github.io

# Optional. Local port (macOS AirPlay Receiver uses 5000, so override if needed).
# PORT=5000
